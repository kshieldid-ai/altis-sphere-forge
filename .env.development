# Chargé automatiquement par `npm run dev` (mode development).
# Backend Django local — port 8000, préfixe /api/altis.
VITE_API_URL=http://localhost:8000/api/altis

# API Django « downloads » (backend/), lancée avec : DJANGO_DEBUG=1 python manage.py runserver 8001
VITE_DOWNLOADS_API_URL=http://localhost:8001/api/downloads

# Veille technologique (même backend Django) : actualités IT du blog, rafraîchies toutes les heures
VITE_VEILLE_API_URL=http://localhost:8001/api/veille
